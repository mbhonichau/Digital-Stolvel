# Copy to .env.local and source it before starting the application. Never commit credentials.
MOMO_API_USER=
MOMO_API_KEY=
MOMO_COLLECTIONS_SUBSCRIPTION_KEY=
MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MOMO_BASE_URL=https://proxy.momoapi.mtn.com
MOMO_TARGET_ENV=mtnsouthafrica
MOMO_CURRENCY=ZAR
# Keep true for local demos; set false to contact the MTN sandbox.
MOMO_MOCK_MODE=false
MOMO_POLL_INTERVAL_MS=5000
